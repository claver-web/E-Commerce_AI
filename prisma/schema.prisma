generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  role          String    @default("USER") // Using String for role since SQLite doesn't support enums natively
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  cart          Cart?
  comments      Comment[]
  reviews       Review[]
  activities    UserActivity[]
}

model Product {
  id              String      @id @default(cuid())
  name            String
  description     String
  price           Float
  category        String
  stock           Int
  specifications  String      // Storing JSON as string for better SQLite compatibility
  images          String      // Storing JSON-stringified array of image URLs
  
  // Amazon Specific Fields
  amazonId           String?   @unique
  discountedPrice    Float?
  actualPrice        Float?
  discountPercentage String?
  avgRating          Float?
  ratingCount        Int?
  aboutProduct       String?
  imgLink            String?
  productLink        String?

  // Urbanic Specific Fields
  urbanicId          String?   @unique
  skuId              Int?
  skcId              Int?
  colorName          String?
  availableColors    String?   // Storing JSON as string
  productUrl         String?
  scrapeDate         String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  comments        Comment[]
  reviews         Review[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
}

model Comment {
  id            String    @id @default(cuid())
  content       String
  userId        String
  productId     String
  parentId      String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  parent        Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies       Comment[] @relation("CommentToComment")
}

model Review {
  id              String    @id @default(cuid())
  rating          Float     // Supporting float ratings from Amazon (4.2, etc.)
  title           String?
  comment         String
  isVerified      Boolean   @default(false)
  
  // Local User (Optional for imported reviews)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  
  // Amazon Specific Fields
  amazonReviewId  String?   @unique
  amazonUserId    String?
  amazonUserName  String?
  
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  
  createdAt       DateTime  @default(now())
  
  @@unique([userId, productId], name: "userId_productId")
}

model Cart {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  items         CartItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CartItem {
  id            String    @id @default(cuid())
  quantity      Int
  productId     String
  cartId        String
  product       Product   @relation(fields: [productId], references: [id])
  cart          Cart      @relation(fields: [cartId], references: [id])
}

model Order {
  id            String    @id @default(cuid())
  userId        String
  razorpayOrderId String  @unique
  razorpayPaymentId String?
  amount        Float
  status        String    @default("PENDING") // Enum fallback
  items         OrderItem[]
  shippingAddress String  // Store JSON-stringified address
  receipt       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  price         Float
  order         Order     @relation(fields: [orderId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
}

model Visitor {
  id            String    @id @default(cuid())
  visitorId     String    @unique // Unique ID stored in browser cookies
  lastSeen      DateTime  @default(now())
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  activities    UserActivity[]
}

model UserActivity {
  id            String    @id @default(cuid())
  userId        String?   // Optional for anonymous visitors
  visitorId     String?   // Link to Visitor model
  action        String    // 'view', 'purchase', 'add_to_cart', 'comment', 'review', 'visit'
  productId     String?
  details       String?   // JSON fallback
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  
  user          User?      @relation(fields: [userId], references: [id])
  visitor       Visitor?   @relation(fields: [visitorId], references: [visitorId])
}

